<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/rootContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Chrome-like top bar matching reference -->
        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#1F1F1F"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_home"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_chrome_home" />

            <RelativeLayout
                android:id="@+id/urlPillContainer"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/chrome_url_pill"
                android:paddingStart="4dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/siteSecurityIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/btn_site_info"
                    android:focusable="true"
                    android:padding="9dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chrome_tune" />

                <ImageButton
                    android:id="@+id/btnClearUrl"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_clear_url"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:visibility="gone"
                    app:tint="#9AA0A6" />

                <EditText
                    android:id="@+id/urlInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/btnClearUrl"
                    android:layout_toEndOf="@id/siteSecurityIcon"
                    android:background="@null"
                    android:hint="@string/url_hint"
                    android:imeOptions="actionGo"
                    android:importantForAutofill="no"
                    android:inputType="textUri|textNoSuggestions"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#E3E3E3"
                    android:textColorHint="#9AA0A6"
                    android:textSize="15sp" />
            </RelativeLayout>

            <ImageButton
                android:id="@+id/btnNewTab"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_new_tab"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_chrome_add" />

            <!-- Tab count container (40dp touch target) -->
            <FrameLayout
                android:id="@+id/btnTabsContainer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/btnTabsPlaceholder"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:background="@drawable/chrome_tab_box"
                    android:clickable="false"
                    android:duplicateParentState="true"
                    android:gravity="center"
                    android:text="@string/btn_tabs_placeholder"
                    android:textColor="#E3E3E3"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_menu"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_chrome_more" />
        </LinearLayout>

        <!-- Find-in-page bar (hidden until invoked from menu) -->
        <LinearLayout
            android:id="@+id/findBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#1F1F1F"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/findInput"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/chrome_url_pill"
                android:hint="@string/find_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#E3E3E3"
                android:textColorHint="#9AA0A6"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/findCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:textColor="#9AA0A6"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnFindPrev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_back"
                android:src="@android:drawable/arrow_up_float"
                app:tint="#E3E3E3" />

            <ImageButton
                android:id="@+id/btnFindNext"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_forward"
                android:src="@android:drawable/arrow_down_float"
                app:tint="#E3E3E3" />

            <ImageButton
                android:id="@+id/btnFindClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_cancel"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#E3E3E3" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/statusRow"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:background="#1F1F1F"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/statusLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/status_ready"
                android:textColor="@color/snake_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <WebView
                    android:id="@+id/webView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAutofill="no" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- Fullscreen flat empty start page (Chrome/WebView-like blank state) -->
            <LinearLayout
                android:id="@+id/startPageCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/startPageIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:alpha="0.5"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_snake_minimal" />

                <TextView
                    android:id="@+id/startCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/start_card_title"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/startCardBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:maxWidth="300dp"
                    android:text="@string/start_card_body"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnStartConfigure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:text="@string/start_card_configure"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnStartDismiss"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:text="@string/start_card_dismiss"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- VPN Kill-Switch block overlay -->
            <LinearLayout
                android:id="@+id/vpnBlockedView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/vpnBlockedIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:alpha="0.65"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_snake_minimal" />

                <TextView
                    android:id="@+id/vpnBlockedTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/vpn_blocked_title"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/vpnBlockedBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:maxWidth="310dp"
                    android:text="@string/vpn_blocked_body"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnVpnRetry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:text="@string/vpn_retry"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnVpnSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:text="@string/vpn_open_settings"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Fullscreen video container -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />
</FrameLayout>
